{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kingdamas_web",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "kingdamas.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kingdamas.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
